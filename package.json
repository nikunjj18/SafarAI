{
  "name": "safarai-pilgrim-guardian",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "npm run catalog && node --env-file-if-exists=.env backend/src/index.ts",
    "catalog": "node scripts/catalog.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "node --test tests/*.test.ts",
    "build": "npm run catalog && npm run typecheck && vite build --config frontend/vite.config.ts --configLoader native && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/backend/src/index.js --production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "3.9.6",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "description": "Pilgrimage group coordination with location sharing, meeting points and multilingual AI assistance."
}
