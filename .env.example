# SafarAI configuration. Copy to .env in THIS project root.
# Node 24+; no private key is exposed through VITE_* variables.
# Core group features work without external API credentials.
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
DATABASE_PATH=./data/safarai-v1.db
# npm start sets production mode automatically.
# NODE_ENV is selected by the start/build commands.
# Optional additional browser origins, comma-separated and exact.
CORS_ORIGINS=
# Set to 1 only behind one trusted reverse proxy; otherwise leave empty.
TRUST_PROXY=

# Choose ONE configured AI provider. Model availability depends on your account.
AI_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=
# Alternative provider; used only when AI_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Nokia Network as Code: use your subscribed gateway and operation versions.
# These URLs are complete HTTPS OPERATION URLs from your provider portal,
# not merely a hostname. Leaving one empty makes that operation unavailable.
# Do not put credentials in URL query strings.
NOKIA_RAPIDAPI_KEY=
NOKIA_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
# Optional consent-scoped carrier bearer token if your operator requires it.
# This token must be authorized for the subscriber used in the request.
NOKIA_ACCESS_TOKEN=
NOKIA_LOCATION_RETRIEVAL_URL=https://network-as-code.p-eu.rapidapi.com/location-retrieval/v0/retrieve
NOKIA_DEVICE_STATUS_URL=https://network-as-code.p-eu.rapidapi.com/device-status/device-reachability-status/v1/retrieve
# Collection URLs supporting POST plus GET/DELETE /{resourceId}.
NOKIA_QOD_URL=https://network-as-code.p-eu.rapidapi.com/quality-on-demand/v1/sessions
NOKIA_GEOFENCING_URL=
NOKIA_CONGESTION_SUBSCRIPTIONS_URL=https://network-as-code.p-eu.rapidapi.com/congestion-insights/v0/subscriptions
# Register APP_URL/api/carrier/oauth/callback with Nokia.
# Register public HTTPS APP_URL/api/carrier/webhook for geofencing events.
# Generate a random token; provider must send Authorization: Bearer <token>.
NOKIA_WEBHOOK_TOKEN=
# QoD concerns traffic to this real application server, not the tel: dialer.
QOD_APPLICATION_SERVER_IPV4=
QOD_PROFILE=QOS_E
GUARDIAN_INTERVAL_SECONDS=45

# AlAdhan prayer calculation method: 4 = Umm al-Qura.
# Google Maps and Places settings are below; Leaflet is an unconfigured-map fallback.
PRAYER_METHOD=4


# UI translation: 30 languages. Empty reuses AI_PROVIDER and its existing key/model.
# Choose gemini, groq, or google (Google Cloud Translation Basic v2).
# English interface does not need a key; translating group content does.
TRANSLATION_PROVIDER=
GOOGLE_TRANSLATE_API_KEY=

# Google Places API (New), backend only. Enable billing and this API.
GOOGLE_PLACES_API_KEY=
# Maps JavaScript API browser key. Restrict to your website HTTP referrers.
# For laptop testing allow http://localhost:3000/*.
GOOGLE_MAPS_BROWSER_KEY=

# Optional VERIFIED pedestrian crowd feed (not Google Places or Nokia network congestion).
# Your trusted source sends measured levels for Google Place IDs to POST /api/crowd/observations.
# Generate a random 32+ character token; keep it on the server and your feed adapter only.
# Leave blank without a real source; the app correctly shows Unknown.
CROWD_WEBHOOK_TOKEN=
CROWD_SOURCE_NAME=

# Explicit presentation mode: saved positions remain visible and boundary checks use their centres.
# Set true for a labelled demo only; false retains live freshness/accuracy validation.
DEMO_MODE=true

# Optional speech-to-text model, using the existing GROQ_API_KEY.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
